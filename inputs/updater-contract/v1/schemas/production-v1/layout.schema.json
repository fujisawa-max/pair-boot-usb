{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pair-boot-usb:production:1:1:layout",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": 1
    },
    "contract_revision": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "[a-z][a-z0-9-]{0,79}"
    },
    "logical_sector_bytes": {
      "const": 512
    },
    "partition_table": {
      "const": "preserve-all-bytes"
    },
    "partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "[a-z][a-z0-9-]{0,79}"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "geometry": {
            "enum": [
              "fixed",
              "target-preserved"
            ]
          },
          "start_sector": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "sector_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "type_guid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}"
          },
          "filesystem": {
            "enum": [
              "fat32",
              "ext4",
              "ntfs"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "operation": {
            "enum": [
              "replace",
              "merge",
              "preserve"
            ]
          }
        },
        "required": [
          "role",
          "number",
          "geometry",
          "start_sector",
          "sector_count",
          "type_guid",
          "filesystem",
          "label",
          "operation"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "coherence_groups": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[a-z][a-z0-9-]{0,79}"
        },
        "minItems": 2,
        "maxItems": 16
      },
      "minItems": 0,
      "maxItems": 16
    },
    "required_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "[a-z][a-z0-9-]{0,79}"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "write_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "[a-z][a-z0-9-]{0,79}"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "managed_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "managed_exact_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "merge": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[a-z][a-z0-9-]{0,79}"
        },
        "registry_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
        },
        "derived_hosts_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
        },
        "marker_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
        },
        "receipt_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
        },
        "migrations": {
          "type": "array",
          "items": {
            "enum": [
              "registry-1-to-2",
              "identity-2"
            ]
          },
          "minItems": 1,
          "maxItems": 16
        },
        "protected_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
          },
          "minItems": 1,
          "maxItems": 4096
        }
      },
      "required": [
        "role",
        "registry_path",
        "derived_hosts_path",
        "marker_path",
        "receipt_path",
        "migrations",
        "protected_roots"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "contract_revision",
    "id",
    "logical_sector_bytes",
    "partition_table",
    "partitions",
    "coherence_groups",
    "required_roles",
    "write_order",
    "managed_roots",
    "managed_exact_paths",
    "merge"
  ],
  "additionalProperties": false
}
