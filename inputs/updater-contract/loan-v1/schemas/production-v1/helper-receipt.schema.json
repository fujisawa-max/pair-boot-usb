{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pair-boot-usb:production:1:1:helper-receipt",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": 1
    },
    "contract_revision": {
      "const": 2
    },
    "helper_protocol": {
      "const": 1
    },
    "contract_lock_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "[0-9a-f]{64}"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "[a-z][a-z0-9-]{0,79}"
    },
    "request_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "[0-9a-f]{64}"
    },
    "manifest_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "[0-9a-f]{64}"
    },
    "target": {
      "type": "object",
      "properties": {
        "target_token_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[0-9a-f]{64}"
        },
        "gpt_snapshot_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "target_token_sha256",
        "gpt_snapshot_sha256"
      ],
      "additionalProperties": false
    },
    "accepted_source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "[a-z][a-z0-9-]{0,79}"
    },
    "helper": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[a-z][a-z0-9-]{0,79}"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)"
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "id",
        "version",
        "source_sha256"
      ],
      "additionalProperties": false
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "[a-z][a-z0-9-]{0,79}"
          },
          "file": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "[0-9a-f]{64}"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "role",
          "file"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "output": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[a-z][a-z0-9-]{0,79}"
        },
        "file": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "filesystem_uuid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "inventory_before": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "inventory_after": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "role",
        "file",
        "filesystem_uuid",
        "inventory_before",
        "inventory_after"
      ],
      "additionalProperties": false
    },
    "registry": {
      "type": "object",
      "properties": {
        "migration": {
          "enum": [
            "registry-1-to-2",
            "identity-2"
          ]
        },
        "before_schema": {
          "enum": [
            1,
            2
          ]
        },
        "after_schema": {
          "const": 2
        },
        "before_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "after_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "before_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[0-9a-f]{64}"
        },
        "after_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[0-9a-f]{64}"
        },
        "preserved_records_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "migration",
        "before_schema",
        "after_schema",
        "before_generation",
        "after_generation",
        "record_count",
        "before_sha256",
        "after_sha256",
        "preserved_records_sha256"
      ],
      "additionalProperties": false
    },
    "preserved_inventory_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "[0-9a-f]{64}"
    },
    "logical_inventory_verified": {
      "const": true
    }
  },
  "required": [
    "contract_version",
    "contract_revision",
    "helper_protocol",
    "contract_lock_sha256",
    "request_id",
    "request_sha256",
    "manifest_sha256",
    "target",
    "accepted_source_id",
    "helper",
    "snapshots",
    "output",
    "registry",
    "preserved_inventory_sha256",
    "logical_inventory_verified"
  ],
  "additionalProperties": false
}
