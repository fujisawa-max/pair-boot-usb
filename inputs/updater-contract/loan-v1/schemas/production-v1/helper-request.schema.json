{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pair-boot-usb:production:1:1:helper-request",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": 1
    },
    "contract_revision": {
      "const": 2
    },
    "helper_protocol": {
      "const": 1
    },
    "contract_lock_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "[0-9a-f]{64}"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "[a-z][a-z0-9-]{0,79}"
    },
    "manifest_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "[0-9a-f]{64}"
    },
    "target": {
      "type": "object",
      "properties": {
        "target_token_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[0-9a-f]{64}"
        },
        "gpt_snapshot_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "target_token_sha256",
        "gpt_snapshot_sha256"
      ],
      "additionalProperties": false
    },
    "selected_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "[a-z][a-z0-9-]{0,79}"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "[a-z][a-z0-9-]{0,79}"
          },
          "file": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "[0-9a-f]{64}"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "role",
          "file"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "helper": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[a-z][a-z0-9-]{0,79}"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)"
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "[0-9a-f]{64}"
        }
      },
      "required": [
        "id",
        "version",
        "source_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "contract_revision",
    "helper_protocol",
    "contract_lock_sha256",
    "request_id",
    "manifest_sha256",
    "target",
    "selected_roles",
    "snapshots",
    "helper"
  ],
  "additionalProperties": false
}
